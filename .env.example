# 使用 32 字节以上随机 Base64 值：node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATABASE_URL=postgres://heyue:change-me@localhost:5432/heyue
APP_MASTER_KEY_BASE64=replace-with-a-random-base64-32-byte-key
SESSION_SECRET=replace-with-a-long-random-string
APP_ORIGIN=http://localhost:5173
PORT=3001
# 必须手工设置。首次创建管理员仅在该值存在时开放。
INITIAL_ADMIN_PASSWORD=
