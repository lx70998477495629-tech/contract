# 使用 32 字节以上随机 Base64 值：node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATABASE_URL=postgres://heyue:请设置强密码@localhost:5432/heyue
POSTGRES_PASSWORD=请设置同一个强密码
APP_MASTER_KEY_BASE64=请运行顶部命令生成
SESSION_SECRET=请设置至少32位随机字符串
APP_ORIGIN=http://localhost:5173
PORT=3001
COOKIE_SECURE=false
# 生产部署还需设置 APP_ORIGIN=https://你的域名、TLS_CERT_PATH、TLS_KEY_PATH
# 必须手工设置。首次创建管理员仅在该值存在时开放。
INITIAL_ADMIN_PASSWORD=
